{
  "name": "avero-telegram-bot",
  "version": "1.0.0",
  "scripts": {
    "dev":   "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test":  "jest --passWithNoTests"
  },
  "dependencies": {
    "telegraf":       "^4.15.6",
    "express":        "^4.18.3",
    "ioredis":        "^5.3.2",
    "pg":             "^8.11.5",
    "axios":          "^1.6.8",
    "node-cron":      "^3.0.3",
    "p-queue":        "^8.0.1",
    "winston":        "^3.12.0",
    "dayjs":          "^1.11.10"
  },
  "devDependencies": {
    "@types/node":     "^20.11.30",
    "@types/pg":       "^8.11.5",
    "@types/node-cron":"^3.0.11",
    "@types/express":  "^4.17.21",
    "jest":            "^29.7.0",
    "ts-jest":         "^29.1.2",
    "ts-node":         "^10.9.2",
    "ts-node-dev":     "^2.0.0",
    "typescript":      "^5.4.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"]
  }
}
