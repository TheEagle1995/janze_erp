# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://avero:password@localhost:5432/avero_erp

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (generate with: openssl rand -hex 32) ─────────────────
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── App ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Internal services ─────────────────────────────────────────
API_INTERNAL_KEY=internal_service_key_min_32_chars

# ── Finance ───────────────────────────────────────────────────
VAT_RATE_PCT=12

# ── Telegram bot webhook (fired when order completes) ─────────
TELEGRAM_BOT_INTERNAL_URL=http://localhost:8080
LARGE_ORDER_THRESHOLD=1000000
